# ──────────────────────────────────────────────────────────────────────────────
# PropertyDeal — Flask backend environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Required — generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Database URL
#   Local development (SQLite — default, no setup needed):
DATABASE_URL=sqlite:///data.db
#   Production (PostgreSQL — from Render dashboard or Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated allowed CORS origins (no trailing slash)
#   Development:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#   Production — replace with your actual Vercel URL:
# CORS_ORIGINS=https://your-app.vercel.app

# Flask debug mode — set to false in production
FLASK_DEBUG=false
