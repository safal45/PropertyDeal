# ──────────────────────────────────────────────────────────────────────────────
# PropertyDeal — React frontend environment variables
# Copy this file to .env.local for local development.
# In Vercel: set these under Project → Settings → Environment Variables.
# NEVER commit .env or .env.local — they are gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
#   Local development:
REACT_APP_API_URL=http://127.0.0.1:5000
#   Production — replace with your Render service URL:
# REACT_APP_API_URL=https://your-backend.onrender.com
